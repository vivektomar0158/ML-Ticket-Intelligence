{
 "title": "Ticket Intelligence",
 "uid": "ticket-intel",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Queue depth by job type",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "jobs_queue_depth",
     "legendFormat": "{{type}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Jobs completed / failed / deferred per second",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (type) (rate(jobs_done_total[1m]))",
     "legendFormat": "done {{type}}",
     "refId": "A"
    },
    {
     "expr": "sum by (type) (rate(jobs_failed_total[1m]))",
     "legendFormat": "failed {{type}}",
     "refId": "B"
    },
    {
     "expr": "sum by (type) (rate(jobs_deferred_total[1m]))",
     "legendFormat": "deferred {{type}}",
     "refId": "C"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Job processing time p95 (s)",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, type) (rate(jobs_processing_seconds_bucket[2m])))",
     "legendFormat": "{{type}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "ML service request latency p95 (s)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"ml-service\"}[2m])))",
     "legendFormat": "{{handler}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "LLM calls per minute by task",
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (task) (rate(llm_calls_total[5m])) * 60",
     "legendFormat": "{{task}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "LLM spend (USD, cumulative) and tokens/s",
   "gridPos": {
    "x": 16,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "llm_cost_usd_total",
     "legendFormat": "cost USD",
     "refId": "A"
    },
    {
     "expr": "sum by (kind) (rate(llm_tokens_total[1m]))",
     "legendFormat": "tokens/s {{kind}}",
     "refId": "B"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Ingest API latency p95 (s)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"api\",uri=~\"/api/tickets.*\"}[2m])))",
     "legendFormat": "{{uri}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Model drift: low-confidence share / category shift",
   "gridPos": {
    "x": 8,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "drift_low_confidence_share",
     "legendFormat": "low-confidence share",
     "refId": "A"
    },
    {
     "expr": "drift_category_shift",
     "legendFormat": "category shift (TVD)",
     "refId": "B"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "JVM heap / DB pool",
   "gridPos": {
    "x": 16,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "jvm_memory_used_bytes{area=\"heap\"}",
     "legendFormat": "heap",
     "refId": "A"
    },
    {
     "expr": "hikaricp_connections_active",
     "legendFormat": "db active",
     "refId": "B"
    }
   ]
  }
 ],
 "templating": {
  "list": []
 },
 "__inputs": [],
 "tags": [
  "ticket-intelligence"
 ]
}