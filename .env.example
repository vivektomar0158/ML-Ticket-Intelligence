# Copy to .env (git-ignored) and fill in.

# --- LLM (Gemini). Leave the key empty and set LLM_PROVIDER=mock to run without any key (drafts become simple templates).
GEMINI_API_KEY=
LLM_PROVIDER=gemini
# Comma-separated, used round-robin; models over their (free-tier) daily quota are skipped automatically.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.6-flash,gemini-flash-lite-latest,gemini-flash-latest,gemini-2.5-flash-lite,gemini-2.5-flash

# --- Database
DB_PASSWORD=ticketintel

# --- Security: CHANGE THESE outside local demos
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
INGEST_API_KEY=dev-ingest-key
ADMIN_KEY=dev-admin-key
SEED_USERS=true
